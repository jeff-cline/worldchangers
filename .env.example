# R0cketShip Core API — the shared "body" this site sits on.
# All shared services (lead tracking, email, SMS, data) go through the Core.
# Get a key from the Core owner (God) at https://worldchangers.ai/core-api.
# Copy this file to .env.local and fill in the real secret. NEVER commit .env.local.

CORE_API_BASE=https://worldchangers.ai
CORE_API_KEY=core_pk_xxxxxxxxxxxx
CORE_API_SECRET=core_sk_xxxxxxxxxxxxxxxxxxxxxxxx

# Port this self-contained app runs on (own process, isolated from other sites).
PORT=3030
